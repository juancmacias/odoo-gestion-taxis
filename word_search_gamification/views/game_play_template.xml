<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Game Play Template -->
    <template id="game_play_template" name="Word Search Game Play">
        <t t-call="web.frontend_layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow-lg">
                            <div class="card-header bg-primary text-white">
                                <h2 class="mb-0">
                                    <i class="fa fa-gamepad"/> <t t-esc="game.name"/>
                                </h2>
                                <p class="mb-0"><t t-esc="game.description"/></p>
                            </div>
                            <div class="card-body">
                                <!-- Game Stats -->
                                <div class="row mb-4">
                                    <div class="col-md-3">
                                        <div class="alert alert-info">
                                            <strong>⏱️ Time:</strong>
                                            <span id="timer" class="ms-2">00:00</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="alert alert-warning">
                                            <strong>🎯 Score:</strong>
                                            <span id="score" class="ms-2">0</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="alert alert-success">
                                            <strong>✅ Found:</strong>
                                            <span id="found-count" class="ms-2">0</span> / <t t-esc="len(words)"/>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="alert alert-secondary">
                                            <strong>📏 Grid:</strong>
                                            <span class="ms-2"><t t-esc="grid_size"/>x<t t-esc="grid_size"/></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <!-- Game Grid -->
                                    <div class="col-lg-8">
                                        <div class="game-container">
                                            <div id="game-grid" class="word-search-grid" t-att-data-size="grid_size">
                                                <t t-foreach="grid" t-as="row">
                                                    <div class="grid-row">
                                                        <t t-foreach="row" t-as="cell">
                                                            <div class="grid-cell" 
                                                                 t-att-data-row="row_index" 
                                                                 t-att-data-col="cell_index">
                                                                <t t-esc="cell if cell else '·'"/>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Words List -->
                                    <div class="col-lg-4">
                                        <div class="card">
                                            <div class="card-header bg-secondary text-white">
                                                <h4 class="mb-0">📝 Words to Find</h4>
                                            </div>
                                            <div class="card-body">
                                                <ul id="words-list" class="list-unstyled">
                                                    <t t-foreach="words" t-as="word">
                                                        <li class="word-item mb-2" t-att-id="'word-' + str(word_index)" t-att-data-word="word">
                                                            <span class="badge bg-light text-dark p-2 w-100">
                                                                <t t-esc="word"/>
                                                            </span>
                                                        </li>
                                                    </t>
                                                </ul>
                                            </div>
                                        </div>

                                        <!-- Game Controls -->
                                        <div class="mt-3">
                                            <button id="reset-game" class="btn btn-warning btn-block w-100 mb-2">
                                                <i class="fa fa-refresh"/> Reset Game
                                            </button>
                                            <button id="save-attempt" class="btn btn-primary btn-block w-100 mb-2">
                                                <i class="fa fa-save"/> Save &amp; Exit
                                            </button>
                                            <a t-attf-href="/web#model=word.search.game&amp;view_type=form&amp;id={{game.id}}" 
                                               class="btn btn-secondary btn-block w-100">
                                                <i class="fa fa-arrow-left"/> Back to Game
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Instructions -->
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <div class="alert alert-info">
                                            <h5>📖 How to Play:</h5>
                                            <ul>
                                                <li>Click and drag to select letters</li>
                                                <li>Find all words in the list</li>
                                                <li>Words can be horizontal, vertical, or diagonal</li>
                                                <li>Try to complete in the shortest time!</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hidden data for JavaScript -->
            <input type="hidden" id="game-id" t-att-value="game.id"/>
            <input type="hidden" id="words-data" t-att-value="json.dumps(words)"/>
        </t>
    </template>

    <!-- Error Template - No Words -->
    <template id="no_words_error" name="No Words Error">
        <t t-call="web.frontend_layout">
            <div class="container mt-5">
                <div class="alert alert-danger">
                    <h3>⚠️ No Words Available</h3>
                    <p>This game doesn't have any words assigned. Please add words before playing.</p>
                    <a t-attf-href="/web#model=word.search.game&amp;view_type=form&amp;id={{game.id}}" 
                       class="btn btn-primary">
                        Back to Game
                    </a>
                </div>
            </div>
        </t>
    </template>
</odoo>
