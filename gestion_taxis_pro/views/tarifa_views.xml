
<odoo>
    <record id="action_tarifas" model="ir.actions.act_window">
        <field name="name">Tarifas</field>
        <field name="res_model">taxi.tarifa</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tarifas" parent="menu_taxi_root" name="Tarifas" action="action_tarifas"/>

    <record id="view_tarifa_tree" model="ir.ui.view">
        <field name="model">taxi.tarifa</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="precio_base"/>
                <field name="precio_km"/>
                <field name="precio_min_espera"/>
            </list>
        </field>
    </record>

    <record id="view_tarifa_form" model="ir.ui.view">
        <field name="model">taxi.tarifa</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="precio_base"/>
                        <field name="precio_km"/>
                        <field name="precio_min_espera"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
